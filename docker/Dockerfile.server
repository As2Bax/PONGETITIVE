FROM node:22-alpine

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY server/ ./server/

# The authoritative simulation loads the *client* game files verbatim, so the
# room service needs them at runtime. Sharing one source of truth is what keeps
# server physics and client prediction from drifting apart.
# Only the simulation modules are copied; render/ui/net stay browser-side.
COPY app/js/core.js app/js/ai.js app/js/gameplay.js app/js/powerups.js app/js/update.js ./app/js/

EXPOSE 8280
CMD ["node", "server/index.js"]
